# Copy to .env (or export in your shell) and adjust the paths.
# Data produced by preprocess/ for one dataset (How2Sign or PHOENIX-2014T).
SIGNGPT_DATA_ROOT=/path/to/dataset_root
# Directory containing t2m/VQVAEV3_CB1024_CMT_H1024_NRES3/meta/{mean,std}_seperate_catexp_new_new.npy
SIGNGPT_STATS_ROOT=/path/to/deps/ASL
# Llama-1B backbone and (optional) instruction-tuned mediator for SLC_demo.py
SIGNGPT_LLM_PATH=./deps/llama-1b
SIGNGPT_INSTRUCT_LLM_PATH=./deps/llama-1b-instruction
# GloVe word vectors for the text evaluator
WORD_VERTILIZER_PATH=./deps/glove
# Stage-2 assets: codebook file and the Stage-1 (VAE) checkpoint
SIGNGPT_CODEBOOK_PATH=/path/to/signgpt_codebook.pt
SIGNGPT_VAE_CKPT=/path/to/stage1_last.ckpt
# Full SignGPT checkpoint for demo.py / test.py
SIGNGPT_CKPT=/path/to/stage2_last.ckpt
# Suffix appended to experiment names (keeps concurrent runs separate)
SIGNGPT_RUN_TAG=minirun
# Output directory for experiments
SIGNGPT_OUTPUT_DIR=./outputs
